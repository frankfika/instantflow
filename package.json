{
  "name": "usend",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.mjs\"",
    "dev:edge": "npm run build && wrangler dev --port 8787",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:edge": "node scripts/edge-smoke.mjs",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "audit:deps": "npm audit --audit-level=high --registry=https://registry.npmjs.org && npm audit --omit=dev --audit-level=moderate --registry=https://registry.npmjs.org",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "check": "npm test && npm run typecheck:worker && npm run audit:deps && npm run deploy:dry-run",
    "deploy": "npm run check && wrangler deploy",
    "start": "node server.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "playwright": "^1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wrangler": "^4.120.0"
  }
}
